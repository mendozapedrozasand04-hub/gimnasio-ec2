<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="cabecera.jsp" %>
<h1>Membresías</h1><p>Asigne un plan o registre una renovación. La fecha final se calcula según la duración del plan.</p>
<section class="panel"><h2>Asignar o renovar membresía</h2><form method="post" class="rejilla"><input type="hidden" name="token" value="<%=session.getAttribute("token")%>">
<label>Cliente<select name="id_cliente" required><option value="">Seleccione</option><%List<Cliente> clientes=(List<Cliente>)request.getAttribute("clientes");if(clientes!=null)for(Cliente c:clientes){%><option value="<%=c.getId()%>" <%=String.valueOf(c.getId()).equals(request.getParameter("id_cliente"))?"selected":""%>><%=Web.html(c.getDocumento()+" - "+c.getNombres()+" "+c.getApellidos())%></option><%}%></select></label>
<label>Plan<select name="id_plan" required><option value="">Seleccione</option><%List<Plan> planes=(List<Plan>)request.getAttribute("planes");if(planes!=null)for(Plan p:planes)if("ACTIVO".equals(p.getEstado())){%><option value="<%=p.getId()%>" <%=String.valueOf(p.getId()).equals(request.getParameter("id_plan"))?"selected":""%>><%=Web.html(p.getNombre())%> - <%=p.getDuracionDias()%> días - S/ <%=p.getPrecio()%></option><%}%></select></label>
<label>Fecha de inicio<input type="date" name="fecha_inicio" min="2000-01-01" max="2100-12-31" required value="<%=Web.html(request.getParameter("fecha_inicio")==null?LocalDate.now(ZoneId.of("America/Lima")):request.getParameter("fecha_inicio"))%>"></label><div class="acciones"><button>Guardar membresía</button></div></form></section>
<section class="panel"><h2>Historial de membresías</h2><form method="get" class="filtros"><label>Nombre o documento<input name="q" value="<%=Web.html(request.getParameter("q"))%>"></label><button>Buscar</button><a href="<%=base%>/membresias">Limpiar</a></form><div class="tabla"><table><thead><tr><th>N.º</th><th>Cliente</th><th>Plan</th><th>Inicio</th><th>Vencimiento</th><th>Precio pactado</th><th>Situación</th><th>Pago</th><th>Acción</th></tr></thead><tbody>
<%List<Membresia> lista=(List<Membresia>)request.getAttribute("membresias");if(lista!=null)for(Membresia m:lista){%><tr><td><%=m.getId()%></td><td><%=Web.html(m.getCliente())%></td><td><%=Web.html(m.getPlan())%></td><td><%=m.getFechaInicio()%></td><td><%=m.getFechaFin()%></td><td>S/ <%=m.getPrecioPactado()%></td><td><%=m.getVigencia()%></td><td><%=m.getPagada()?"Completo":"Pendiente"%></td><td><%if(!"CANCELADA".equals(m.getEstado())){%><form method="post" data-confirmar="¿Cancelar esta membresía? Su pago se conserva; no se realizan devoluciones."><input type="hidden" name="token" value="<%=session.getAttribute("token")%>"><input type="hidden" name="id" value="<%=m.getId()%>"><button name="accion" value="cancelar" class="peligro">Cancelar</button></form><%}%></td></tr><%}%>
<%if(lista==null||lista.isEmpty()){%><tr><td colspan="9">No hay membresías para mostrar.</td></tr><%}%></tbody></table></div></section><%@ include file="pie.jsp" %>
