<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="cabecera.jsp" %><h1>Pagos</h1><p>Un pago completo por membresía. No se admiten abonos parciales.</p>
<section class="panel"><h2>Registrar pago</h2><form method="post" class="rejilla"><input type="hidden" name="token" value="<%=session.getAttribute("token")%>">
<label>Membresía pendiente<select name="id_membresia" id="membresia-pago" required><option value="">Seleccione</option><%List<Membresia> lista=(List<Membresia>)request.getAttribute("membresias");if(lista!=null)for(Membresia m:lista)if(!m.getPagada()&&!"CANCELADA".equals(m.getEstado())){%><option value="<%=m.getId()%>" data-monto="<%=m.getPrecioPactado()%>" <%=String.valueOf(m.getId()).equals(request.getParameter("id_membresia"))?"selected":""%>>N.º <%=m.getId()%> - <%=Web.html(m.getCliente())%> - <%=Web.html(m.getPlan())%> - S/ <%=m.getPrecioPactado()%></option><%}%></select></label>
<label>Monto completo (S/)<input type="number" name="monto" id="monto-pago" step="0.01" min="0.01" required readonly></label>
<label>Método de pago<select name="metodo_pago" required><%for(String metodo:List.of("Efectivo","Transferencia","Tarjeta","Billetera digital")){%><option <%=metodo.equals(request.getParameter("metodo_pago"))?"selected":""%>><%=metodo%></option><%}%></select></label><div class="acciones"><button>Registrar pago</button></div></form></section>
<section class="panel"><h2>Historial de pagos</h2><form method="get" class="filtros"><label>Desde<input type="date" name="desde" required value="<%=Web.html(request.getAttribute("desde"))%>"></label><label>Hasta<input type="date" name="hasta" required value="<%=Web.html(request.getAttribute("hasta"))%>"></label><label>Nombre o documento<input name="q" value="<%=Web.html(request.getParameter("q"))%>"></label><label>Método<select name="metodo"><option value="">Todos</option><%for(String metodo:List.of("Efectivo","Transferencia","Tarjeta","Billetera digital")){%><option <%=metodo.equals(request.getParameter("metodo"))?"selected":""%>><%=metodo%></option><%}%></select></label><button>Consultar</button><a href="<%=base%>/pagos">Limpiar</a></form><div class="tabla"><table><thead><tr><th>N.º</th><th>Cliente</th><th>Membresía</th><th>Fecha</th><th>Método</th><th>Monto</th></tr></thead><tbody><%List<Pago> pagos=(List<Pago>)request.getAttribute("pagos");if(pagos!=null)for(Pago p:pagos){%><tr><td><%=p.getId()%></td><td><%=Web.html(p.getCliente())%></td><td><%=p.getIdMembresia()%></td><td><%=Web.html(p.getFecha())%></td><td><%=Web.html(p.getMetodo())%></td><td>S/ <%=p.getMonto()%></td></tr><%}%><%if(pagos==null||pagos.isEmpty()){%><tr><td colspan="6">No hay pagos para el periodo seleccionado.</td></tr><%}%></tbody></table></div></section><%@ include file="pie.jsp" %>
